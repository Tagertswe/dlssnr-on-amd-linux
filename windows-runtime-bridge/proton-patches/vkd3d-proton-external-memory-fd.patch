+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+#include "d3d12_crosstest.h"
+
+/* Covers the opt-in VKD3D_CONFIG=external_memory_fd path added to
+ * heap.c, resource.c and device.c: an ID3D12Resource backed by a
+ * *buffer* (not a texture) created with D3D12_HEAP_FLAG_SHARED should
+ * hand back a real Linux file descriptor from CreateSharedHandle(),
+ * instead of the Win32-style handle path that produces no usable
+ * handle when running under Wine (D3DKMTShareObjects reports success
+ * without a real handle there, and the Vulkan Win32 external-memory
+ * handle types have no native counterpart on a non-Windows driver).
+ *
+ * Buffers, not textures, are the shape this feature actually exists
+ * for: the real external caller (a HIP/CUDA interop bridge sharing
+ * memory with a separate compute runtime in the same process) always
+ * allocates shared *buffers* on a heap, never shared textures - an
+ * earlier version of this feature targeted the texture-only export
+ * path in d3d12_resource_create_committed() and, as a result, never
+ * exercised the code the real caller needs. Two allocation routes can
+ * produce a shared buffer, and both got patched, so both get their
+ * own test here:
+ *   - ID3D12Device::CreateCommittedResource(D3D12_HEAP_FLAG_SHARED)
+ *     with a buffer desc (resource.c's committed-buffer branch)
+ *   - ID3D12Device::CreateHeap(D3D12_HEAP_FLAG_SHARED) followed by
+ *     CreatePlacedResource (heap.c's d3d12_heap_init())
+ *
+ * Every test below that isn't specifically checking the opt-in path
+ * itself treats "the extension is not enabled" as an expected,
+ * non-failing outcome, since the feature is off by default. */
+
+static ID3D12Resource *create_shared_buffer_desc(ID3D12Device *device, const D3D12_HEAP_PROPERTIES *heap_props,
+        D3D12_RESOURCE_DESC *resource_desc, UINT64 size)
+{
+    ID3D12Resource *resource;
+    HRESULT hr;
+
+    memset(resource_desc, 0, sizeof(*resource_desc));
+    resource_desc->Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    resource_desc->Width = size;
+    resource_desc->Height = 1;
+    resource_desc->DepthOrArraySize = 1;
+    resource_desc->MipLevels = 1;
+    resource_desc->SampleDesc.Count = 1;
+    resource_desc->Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    resource_desc->Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    hr = ID3D12Device_CreateCommittedResource(device, heap_props, D3D12_HEAP_FLAG_SHARED,
+            resource_desc, D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void **)&resource);
+    if (FAILED(hr))
+        return NULL;
+
+    return resource;
+}
+
+static bool config_flag_is_set(void)
+{
+    return !!(getenv("VKD3D_CONFIG") && strstr(getenv("VKD3D_CONFIG"), "external_memory_fd"));
+}
+
+/* A real fd is a small, non-negative integer; the codebase's own KMT
+ * vs. Win32 handle-shape heuristic (see the shared_handle import
+ * branch in resource.c) already tests the same high bits to tell
+ * those two apart, so reusing it here to also rule out "fd-shaped" is
+ * consistent with how vkd3d-proton itself reasons about handle shape,
+ * not a test-only invention. */
+static bool handle_looks_like_fd(HANDLE handle)
+{
+    INT_PTR value = (INT_PTR)handle;
+    return value >= 0 && !((UINT_PTR)handle & 0xc0000000);
+}
+
+void test_external_memory_fd_shared_committed_buffer(void)
+{
+    D3D12_HEAP_PROPERTIES heap_props;
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    HANDLE shared_handle;
+    HRESULT hr;
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_props, 0, sizeof(heap_props));
+    heap_props.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+    if (!(resource = create_shared_buffer_desc(context.device, &heap_props, &resource_desc, 64 * 1024)))
+    {
+        skip("Failed to create shared committed buffer resource.\n");
+        destroy_test_context(&context);
+        return;
+    }
+
+    shared_handle = NULL;
+    hr = ID3D12Device_CreateSharedHandle(context.device, (ID3D12DeviceChild *)resource,
+            NULL, GENERIC_ALL, NULL, &shared_handle);
+
+    if (config_flag_is_set())
+    {
+        ok(hr == S_OK, "CreateSharedHandle on a shared committed buffer failed, hr %#x.\n", (int)hr);
+        ok(shared_handle != NULL, "Expected a non-null shared handle.\n");
+        if (hr == S_OK && shared_handle)
+            ok(handle_looks_like_fd(shared_handle), "Expected an fd-shaped handle, got %p.\n", shared_handle);
+    }
+    /* Not asserting hr == S_OK when the flag is unset: see
+     * test_external_memory_fd_default_off_committed_buffer for that. */
+
+    ID3D12Resource_Release(resource);
+    destroy_test_context(&context);
+}
+
+void test_external_memory_fd_shared_heap_placed_buffer(void)
+{
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    D3D12_HEAP_DESC heap_desc;
+    HANDLE shared_handle;
+    ID3D12Heap *heap;
+    HRESULT hr;
+
+    static const UINT64 heap_size = 64 * 1024;
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_desc, 0, sizeof(heap_desc));
+    heap_desc.SizeInBytes = heap_size;
+    heap_desc.Properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+    heap_desc.Flags = D3D12_HEAP_FLAG_SHARED | D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+
+    if (FAILED(hr = ID3D12Device_CreateHeap(context.device, &heap_desc, &IID_ID3D12Heap, (void **)&heap)))
+    {
+        ok(hr == S_OK, "CreateHeap with D3D12_HEAP_FLAG_SHARED failed, hr %#x.\n", (int)hr);
+        destroy_test_context(&context);
+        return;
+    }
+
+    memset(&resource_desc, 0, sizeof(resource_desc));
+    resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    resource_desc.Width = heap_size;
+    resource_desc.Height = 1;
+    resource_desc.DepthOrArraySize = 1;
+    resource_desc.MipLevels = 1;
+    resource_desc.SampleDesc.Count = 1;
+    resource_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    resource_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    if (FAILED(hr = ID3D12Device_CreatePlacedResource(context.device, heap, 0, &resource_desc,
+            D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void **)&resource)))
+    {
+        skip("Failed to create placed buffer resource on shared heap, hr %#x.\n", (int)hr);
+        ID3D12Heap_Release(heap);
+        destroy_test_context(&context);
+        return;
+    }
+
+    /* CreateSharedHandle can be called on either the heap or a resource
+     * placed on it; the real caller shares the resource, so that's what
+     * this test exercises - GetVulkanHeapInfo-style heap introspection
+     * is already covered elsewhere in this suite. */
+    shared_handle = NULL;
+    hr = ID3D12Device_CreateSharedHandle(context.device, (ID3D12DeviceChild *)resource,
+            NULL, GENERIC_ALL, NULL, &shared_handle);
+
+    if (config_flag_is_set())
+    {
+        ok(hr == S_OK, "CreateSharedHandle on a placed buffer over a shared heap failed, hr %#x.\n", (int)hr);
+        ok(shared_handle != NULL, "Expected a non-null shared handle.\n");
+        if (hr == S_OK && shared_handle)
+            ok(handle_looks_like_fd(shared_handle), "Expected an fd-shaped handle, got %p.\n", shared_handle);
+    }
+
+    ID3D12Resource_Release(resource);
+    ID3D12Heap_Release(heap);
+    destroy_test_context(&context);
+}
+
+/* Regression: with the opt-in flag not set (the common case for every
+ * game other than the one this feature was written for), sharing a
+ * committed buffer resource must keep working exactly as it did
+ * before this feature existed - whatever that outcome is on this
+ * system - and vkGetMemoryFdKHR must remain unavailable. This is the
+ * "did we actually leave everyone else's behaviour alone" half of the
+ * change for the committed-resource allocation route. */
+void test_external_memory_fd_default_off_committed_buffer(void)
+{
+    D3D12_HEAP_PROPERTIES heap_props;
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    VkDevice vk_device = VK_NULL_HANDLE;
+    HANDLE shared_handle;
+    HRESULT hr;
+
+    if (config_flag_is_set())
+    {
+        skip("VKD3D_CONFIG=external_memory_fd is set for this run; "
+                "this test only covers the default-off behaviour.\n");
+        return;
+    }
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_props, 0, sizeof(heap_props));
+    heap_props.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+    if (!(resource = create_shared_buffer_desc(context.device, &heap_props, &resource_desc, 64 * 1024)))
+    {
+        skip("Failed to create shared committed buffer resource.\n");
+        destroy_test_context(&context);
+        return;
+    }
+
+    shared_handle = NULL;
+    hr = ID3D12Device_CreateSharedHandle(context.device, (ID3D12DeviceChild *)resource,
+            NULL, GENERIC_ALL, NULL, &shared_handle);
+    (void)hr; /* Outcome depends on the pre-existing Win32/KMT path; not this feature's concern when disabled. */
+
+    if (init_vulkan_loader())
+    {
+        ID3D12DXVKInteropDevice *interop_device;
+        VkInstance vk_instance;
+        VkPhysicalDevice vk_physical_device;
+
+        if (SUCCEEDED(ID3D12Device_QueryInterface(context.device,
+                &IID_ID3D12DXVKInteropDevice, (void **)&interop_device)))
+        {
+            if (SUCCEEDED(ID3D12DXVKInteropDevice_GetVulkanHandles(interop_device,
+                    &vk_instance, &vk_physical_device, &vk_device)))
+            {
+                ok(!pfn_vkGetDeviceProcAddr(vk_device, "vkGetMemoryFdKHR"),
+                        "Expected vkGetMemoryFdKHR to be unavailable without VKD3D_CONFIG=external_memory_fd.\n");
+            }
+            ID3D12DXVKInteropDevice_Release(interop_device);
+        }
+    }
+
+    ID3D12Resource_Release(resource);
+    destroy_test_context(&context);
+}
