diff --git a/tests/d3d12_external_memory_fd.c b/tests/d3d12_external_memory_fd.c
new file mode 100644
index 0000000..bf4d40b
--- /dev/null
+++ b/tests/d3d12_external_memory_fd.c
@@ -0,0 +1,602 @@
+
+/*
+ * Copyright 2026 Martin Olsson
+ *
