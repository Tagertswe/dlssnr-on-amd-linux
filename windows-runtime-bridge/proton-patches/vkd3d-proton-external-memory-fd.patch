+/* Non-regression: this feature is deliberately scoped to buffers only
+ * (see the comment on the buffer branch of d3d12_resource_create_committed()
+ * in resource.c). A *shared texture*, even with the opt-in flag set,
+ * must still go through the pre-existing, untouched Win32 export path -
+ * proving the change did not silently widen its own scope to resource
+ * types it was never designed or tested for. */
+void test_external_memory_fd_shared_texture_unaffected(void)
+{
+    D3D12_HEAP_PROPERTIES heap_props;
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    HANDLE shared_handle;
+    HRESULT hr;
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_props, 0, sizeof(heap_props));
+    heap_props.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+    memset(&resource_desc, 0, sizeof(resource_desc));
+    resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    resource_desc.Width = 64;
+    resource_desc.Height = 64;
+    resource_desc.DepthOrArraySize = 1;
+    resource_desc.MipLevels = 1;
+    resource_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    resource_desc.SampleDesc.Count = 1;
+    resource_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+    resource_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    hr = ID3D12Device_CreateCommittedResource(context.device, &heap_props, D3D12_HEAP_FLAG_SHARED,
+            &resource_desc, D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void **)&resource);
+    if (FAILED(hr))
+    {
+        skip("Failed to create shared texture resource, hr %#x.\n", (int)hr);
+        destroy_test_context(&context);
+        return;
+    }
+
+    shared_handle = NULL;
+    hr = ID3D12Device_CreateSharedHandle(context.device, (ID3D12DeviceChild *)resource,
+            NULL, GENERIC_ALL, NULL, &shared_handle);
+
+    /* Whatever this system's pre-existing Win32/KMT texture-sharing
+     * outcome is, it must be identical regardless of the opt-in flag -
+     * this test's only job is to prove textures never take the fd
+     * branch even when the flag is on, not to grade that pre-existing
+     * outcome itself. */
+    if (hr == S_OK && shared_handle)
+    {
+        ok(!handle_looks_like_fd(shared_handle),
+                "A shared texture unexpectedly produced an fd-shaped handle - "
+                "the fd export path is meant to be buffer-only.\n");
+    }
+
+    ID3D12Resource_Release(resource);
+    destroy_test_context(&context);
+}
+
+/* Non-regression: an ordinary, non-shared buffer - the overwhelming
+ * majority of every buffer any game ever allocates - must be entirely
+ * unaffected by this feature, opt-in flag set or not. In particular,
+ * it must remain usable for normal GPU work (map, write, submit,
+ * read back), confirming the conditional VkExportMemoryAllocateInfo
+ * attachment in resource.c/heap.c is correctly gated on
+ * D3D12_HEAP_FLAG_SHARED and does not leak into the common case. */
+void test_external_memory_fd_non_shared_buffer_unaffected(void)
+{
+    D3D12_HEAP_PROPERTIES heap_props;
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    HRESULT hr;
+    void *data;
+    static const UINT64 buffer_size = 256;
+    static const uint8_t pattern = 0x5a;
+    D3D12_RANGE read_range = {0, 0};
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_props, 0, sizeof(heap_props));
+    heap_props.Type = D3D12_HEAP_TYPE_UPLOAD;
+
+    memset(&resource_desc, 0, sizeof(resource_desc));
+    resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    resource_desc.Width = buffer_size;
+    resource_desc.Height = 1;
+    resource_desc.DepthOrArraySize = 1;
+    resource_desc.MipLevels = 1;
+    resource_desc.SampleDesc.Count = 1;
+    resource_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+    hr = ID3D12Device_CreateCommittedResource(context.device, &heap_props, D3D12_HEAP_FLAG_NONE,
+            &resource_desc, D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void **)&resource);
+    ok(hr == S_OK, "Failed to create ordinary upload buffer, hr %#x.\n", (int)hr);
+    if (FAILED(hr))
+    {
+        destroy_test_context(&context);
+        return;
+    }
+
+    hr = ID3D12Resource_Map(resource, 0, &read_range, &data);
+    ok(hr == S_OK, "Failed to map ordinary upload buffer, hr %#x.\n", (int)hr);
+    if (hr == S_OK)
+    {
+        memset(data, pattern, buffer_size);
+        ID3D12Resource_Unmap(resource, 0, NULL);
+    }
+
+    ID3D12Resource_Release(resource);
+    destroy_test_context(&context);
+}
+
+/* docs/linux-support-spec.md \xc2\xa737-\xc2\xa740: the real, hardware-confirmed
+ * crash cause chased through this whole project's Linux port work is a
+ * GPU page fault at exactly 0x100000000 (2^32/4GB), and a real
+ * mitigation attempt (capping this project's total outstanding GPU
+ * allocation) was live-tested and ruled out (\xc2\xa740 - the fault still
+ * happened with only ~720MB actually outstanding). This test checks a
+ * narrower, directly answerable question, independent of danielblnc's
+ * own proprietary kernels entirely: does a real D3D12 UAV, over the
+ * same D3D12_HEAP_FLAG_SHARED buffer shape this feature's real caller
+ * uses, declared with a FirstElement offset that pushes the *actual*
+ * accessed byte address out to exactly that same fault address - a
+ * real, deliberate, far out-of-bounds access relative to a small (256
+ * byte) real backing allocation - cause the GPU to genuinely fault
+ * (device removed), or does real out-of-bounds UAV access get safely
+ * handled (clamped/ignored), the documented robustness behavior
+ * D3D12/Vulkan drivers are supposed to provide?
+ *
+ * FirstElement is a real UINT64 D3D12 API field, so reaching this
+ * exact address needs no shader-side arithmetic at all - this
+ * isolates "can a genuinely out-of-bounds access at this address
+ * fault the GPU on its own" from "is there a 32-bit overflow bug
+ * somewhere upstream computing a bad address" (which would need
+ * danielblnc's own kernel source to actually find - see \xc2\xa740c). The
+ * compute shader itself is reused, unmodified, from this test suite's
+ * own command-preservation coverage
+ * (tests/shaders/command/root_parameter_preservation_cs.cs_5_0.hlsl -
+ * chosen for being the shortest existing UAV-write shader anywhere in
+ * this suite, shader model 5.0/DXBC, no shader-model gate needed): a
+ * single thread's InterlockedAdd touches exactly element [0] of
+ * whatever view is bound, which FirstElement places at exactly
+ * 0x100000000.
+ *
+ * Not a pass/fail regression check - a real, live diagnostic probe.
+ * Both real outcomes are informative and are reported via trace(),
+ * not asserted with ok(): see the comment right after the dispatch
+ * below for what each outcome would mean. */
+void test_external_memory_fd_shared_buffer_far_offset_access(void)
+{
+    D3D12_ROOT_SIGNATURE_DESC root_signature_desc;
+    D3D12_DESCRIPTOR_RANGE descriptor_ranges[1];
+    D3D12_ROOT_PARAMETER root_parameters[1];
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu_handle;
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu_handle;
+    ID3D12DescriptorHeap *gpu_heap, *cpu_heap;
+    D3D12_HEAP_PROPERTIES heap_props;
+    D3D12_RESOURCE_DESC resource_desc;
+    ID3D12PipelineState *pso;
+    ID3D12Resource *resource;
+    struct test_context context;
+    HRESULT hr;
+
+    /* Shader model 5.0 (DXBC, not DXIL) - RWStructuredBuffer<uint>
+     * RWBuf : register(u1); InterlockedAdd(RWBuf[0], 1, v); - the
+     * shortest existing UAV-write shader anywhere in this test suite
+     * (tests/shaders/command/root_parameter_preservation_cs.cs_5_0.hlsl),
+     * reused unmodified. A single thread touches exactly element [0]
+     * of whatever UAV view is bound - which FirstElement below places
+     * at exactly the real fault address, with no shader-side
+     * arithmetic and no shader-model requirements to gate on. */
+#include "shaders/command/headers/root_parameter_preservation_cs.h"
+
+    if (!config_flag_is_set())
+    {
+        skip("VKD3D_CONFIG=external_memory_fd not set; this probe only makes sense with it enabled.\n");
+        return;
+    }
+
+    if (!init_compute_test_context(&context))
+        return;
+
+    memset(&heap_props, 0, sizeof(heap_props));
+    heap_props.Type = D3D12_HEAP_TYPE_DEFAULT;
+
+    /* Real, small allocation - matching the actual shape this
+     * project's real buffers are (docs/linux-support-spec.md \xc2\xa740:
+     * real outstanding allocation at fault time was ~720MB total
+     * across many buffers, not one huge one), not a buffer that is
+     * itself 4GB+. */
+    if (!(resource = create_shared_buffer_desc(context.device, &heap_props, &resource_desc, 256)))
+    {
+        skip("Failed to create shared committed buffer resource.\n");
+        destroy_test_context(&context);
+        return;
+    }
+
+    root_signature_desc.NumParameters = 1;
+    root_signature_desc.Flags = 0;
+    root_signature_desc.NumStaticSamplers = 0;
+    root_signature_desc.pStaticSamplers = NULL;
+    root_signature_desc.pParameters = root_parameters;
+
+    root_parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    root_parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    root_parameters[0].DescriptorTable.NumDescriptorRanges = 1;
+    root_parameters[0].DescriptorTable.pDescriptorRanges = descriptor_ranges;
+
+    /* u1 - matches RWBuf : register(u1) in the reused shader. */
+    descriptor_ranges[0].RegisterSpace = 0;
+    descriptor_ranges[0].BaseShaderRegister = 1;
+    descriptor_ranges[0].OffsetInDescriptorsFromTableStart = 0;
+    descriptor_ranges[0].NumDescriptors = 1;
+    descriptor_ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+
+    hr = create_root_signature(context.device, &root_signature_desc, &context.root_signature);
+    ok(SUCCEEDED(hr), "Failed to create root signature, hr %#x.\n", (int)hr);
+
+    pso = create_compute_pipeline_state(context.device,
+            context.root_signature, root_parameter_preservation_cs_dxbc);
+
+    gpu_heap = create_gpu_descriptor_heap(context.device, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 1);
+    cpu_heap = create_cpu_descriptor_heap(context.device, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 1);
+    cpu_handle = ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(cpu_heap);
+    gpu_handle = ID3D12DescriptorHeap_GetGPUDescriptorHandleForHeapStart(gpu_heap);
+
+    memset(&uav_desc, 0, sizeof(uav_desc));
+    uav_desc.Format = DXGI_FORMAT_UNKNOWN;
+    uav_desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+    /* 0x100000000 bytes / 4 bytes-per-element (StructureByteStride) -
+     * the exact real fault address from the captured devcoredump
+     * (docs/linux-support-spec.md \xc2\xa738c), reached here via a real
+     * D3D12 API field (FirstElement is UINT64), not shader arithmetic.
+     * Element [0] of this view - the only element the shader ever
+     * touches - lands at exactly that byte address. */
+    uav_desc.Buffer.FirstElement = 0x100000000ull / 4;
+    uav_desc.Buffer.NumElements = 1;
+    uav_desc.Buffer.StructureByteStride = 4;
+    uav_desc.Buffer.CounterOffsetInBytes = 0;
+    uav_desc.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_NONE;
+    ID3D12Device_CreateUnorderedAccessView(context.device, resource, NULL, &uav_desc, cpu_handle);
+
+    ID3D12GraphicsCommandList_SetDescriptorHeaps(context.list, 1, &gpu_heap);
+    ID3D12GraphicsCommandList_SetComputeRootSignature(context.list, context.root_signature);
+    ID3D12GraphicsCommandList_SetComputeRootDescriptorTable(context.list, 0, gpu_handle);
+    ID3D12GraphicsCommandList_SetPipelineState(context.list, pso);
+    /* [numthreads(1,1,1)], one group - a single InterlockedAdd at
+     * exactly byte 0x100000000, never anywhere near the real 256-byte
+     * backing allocation itself. */
+    ID3D12GraphicsCommandList_Dispatch(context.list, 1, 1, 1);
+
+    wait_queue_idle(context.device, context.queue);
+
+    hr = ID3D12Device_GetDeviceRemovedReason(context.device);
+    trace("GetDeviceRemovedReason after a real UAV access at 0x100000000: hr %#x.\n", (int)hr);
+    /* S_OK means the GPU/driver safely handled this genuinely
+     * out-of-bounds access on its own - a real out-of-bounds D3D12 UAV
+     * access at this exact address is NOT, by itself, what faults the
+     * GPU, and the real cause must be something that produces an
+     * actually-invalid (not just out-of-declared-view-bounds) GPU
+     * virtual address instead - most likely still a real bug inside
+     * danielblnc's own kernels (docs/linux-support-spec.md \xc2\xa740c).
+     * Anything else (DXGI_ERROR_DEVICE_REMOVED/DXGI_ERROR_DEVICE_HUNG)
+     * means a genuinely out-of-bounds D3D12 UAV access at this address
+     * can, on its own, take the device down here - a real, independent
+     * finding about this system's driver/hardware robustness, separate
+     * from anything danielblnc's kernels do. */
+
+    ID3D12PipelineState_Release(pso);
+    ID3D12Resource_Release(resource);
+    ID3D12DescriptorHeap_Release(gpu_heap);
+    ID3D12DescriptorHeap_Release(cpu_heap);
+    destroy_test_context(&context);
+}
