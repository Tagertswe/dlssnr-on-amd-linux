+/* Same regression coverage as above, for the CreateHeap + CreatePlacedResource
+ * allocation route (heap.c's d3d12_heap_init()). */
+void test_external_memory_fd_default_off_heap_placed_buffer(void)
+{
+    D3D12_RESOURCE_DESC resource_desc;
+    struct test_context context;
+    ID3D12Resource *resource;
+    D3D12_HEAP_DESC heap_desc;
+    HANDLE shared_handle;
+    ID3D12Heap *heap;
+    HRESULT hr;
+
+    static const UINT64 heap_size = 64 * 1024;
+
+    if (config_flag_is_set())
+    {
+        skip("VKD3D_CONFIG=external_memory_fd is set for this run; "
+                "this test only covers the default-off behaviour.\n");
+        return;
+    }
+
+    if (!init_test_context(&context, NULL))
+        return;
+
+    memset(&heap_desc, 0, sizeof(heap_desc));
+    heap_desc.SizeInBytes = heap_size;
+    heap_desc.Properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+    heap_desc.Flags = D3D12_HEAP_FLAG_SHARED | D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS;
+
+    if (FAILED(hr = ID3D12Device_CreateHeap(context.device, &heap_desc, &IID_ID3D12Heap, (void **)&heap)))
+    {
+        ok(hr == S_OK, "CreateHeap with D3D12_HEAP_FLAG_SHARED failed, hr %#x.\n", (int)hr);
+        destroy_test_context(&context);
+        return;
+    }
+
+    memset(&resource_desc, 0, sizeof(resource_desc));
+    resource_desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    resource_desc.Width = heap_size;
+    resource_desc.Height = 1;
+    resource_desc.DepthOrArraySize = 1;
+    resource_desc.MipLevels = 1;
+    resource_desc.SampleDesc.Count = 1;
+    resource_desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    resource_desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+
+    if (SUCCEEDED(hr = ID3D12Device_CreatePlacedResource(context.device, heap, 0, &resource_desc,
+            D3D12_RESOURCE_STATE_COMMON, NULL, &IID_ID3D12Resource, (void **)&resource)))
+    {
+        shared_handle = NULL;
+        hr = ID3D12Device_CreateSharedHandle(context.device, (ID3D12DeviceChild *)resource,
+                NULL, GENERIC_ALL, NULL, &shared_handle);
+        (void)hr;
+
+        ID3D12Resource_Release(resource);
+    }
+
+    ID3D12Heap_Release(heap);
+    destroy_test_context(&context);
+}
